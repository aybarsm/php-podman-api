{
    "name": "aybarsm/podman-api",
    "description": "",
    "type": "library",
    "license": "MIT",
    "keywords": ["podman", "api-client"],
    "homepage": "https://github.com/aybarsm/php-podman-api",
    "authors": [
        {
            "name": "Murat Aybars",
            "email": "hello@aybarsm.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9.3",
        "guzzlehttp/psr7": "^2.7",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.0.1",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Aybarsm\\Podman\\Api\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
