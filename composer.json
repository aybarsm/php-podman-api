{
    "name": "aybarsm/podman-api",
    "description": "Typed, resource-oriented PHP client for the Podman Libpod REST API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["podman", "libpod", "containers", "api-client"],
    "homepage": "https://github.com/aybarsm/php-podman-api",
    "authors": [
        {
            "name": "Murat Aybars",
            "email": "hello@aybarsm.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9.3",
        "guzzlehttp/psr7": "^2.7",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.0.1",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^4",
        "phpstan/phpstan": "^2",
        "symfony/yaml": "^7"
    },
    "suggest": {
        "ext-curl": "Required to connect over a unix socket (the default Podman transport)."
    },
    "autoload": {
        "psr-4": {
            "Aybarsm\\Podman\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aybarsm\\Podman\\Api\\Dev\\": "dev-tools/src/",
            "Aybarsm\\Podman\\Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@analyse"
        ],
        "test:unit": "pest --testsuite=unit,arch",
        "test:integration": "pest --testsuite=integration",
        "analyse": "phpstan analyse --memory-limit=1G",
        "spec": "php bin/spec"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
